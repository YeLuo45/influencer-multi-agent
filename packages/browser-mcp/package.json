{
  "name": "@ima/browser-mcp",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "start": "node --import tsx src/cli.ts",
    "start:http": "node --import tsx src/http-cli.ts"
  },
  "dependencies": {
    "@ima/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "@types/node": "20.12.7"
  }
}
