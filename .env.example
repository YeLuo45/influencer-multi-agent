# Mock LLM is used by default — zero external dependency.
# Uncomment and fill to switch to a real OpenAI-compatible endpoint.

# Any OpenAI-compatible endpoint works:
#   - OpenAI: https://api.openai.com/v1
#   - Anthropic via OpenAI proxy: https://api.your-proxy.com/v1
#   - CRS / 智谱 / 月之暗面 / DeepSeek etc.
# IMA_LLM_ENDPOINT=https://api.openai.com/v1
# IMA_LLM_KEY=sk-your-key-here
# IMA_LLM_MODEL=gpt-4o-mini

# Crawler / engagement fallback flags
IMA_CRAWLER_PREFER=http          # http | playwright | crawl4ai | mock
IMA_BROWSER_HEADLESS=true

# MCP HTTP server
IMA_MCP_HTTP_HOST=127.0.0.1
IMA_MCP_HTTP_PORT=3000

# Engagement feedback
IMA_FEEDBACK_WINDOW_DAYS=7       # 只看最近 N 天
IMA_FEEDBACK_MIN_SAMPLES=1        # 触发 ranker 加成的最小样本数

# Storage
IMA_STORAGE_ROOT=.ima             # 可改成绝对路径 /tmp/foo 等